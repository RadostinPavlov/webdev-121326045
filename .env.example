# Harmless local placeholders. Copy this file to .env; never put real values in git.
PORT=3000
# Render supplies PORT; locally, use the port you want the server to listen on.
# Optional: public app URL used for OAuth redirects; use your Render URL in production.
PUBLIC_BASE_URL=http://localhost:3000
# Required: use the connection URL from your PostgreSQL provider, or a local database.
DATABASE_URL=postgres://user:password@localhost:5432/clubevents
# Required: generate a private random value for local use; put production values in Render's environment settings.
SESSION_SECRET=replace-with-a-random-local-secret
# Optional: set to production on Render; leave development locally.
NODE_ENV=development

# Optional: create an OAuth 2.0 web client in Google Cloud Console; use its client ID.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
# Optional: use the matching client secret from Google Cloud; store production values in Render.
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Optional: get a Gemini API key from Google AI Studio; configure production in Render.
GEMINI_API_KEY=replace-with-a-gemini-api-key
# Optional: use a model ID listed in Google AI Studio; unset this to keep model assistance unavailable.
MODEL_NAME=replace-with-a-supported-gemini-model

# Optional: generate a random member token; the seed stores its hash and the MCP client uses this value.
MCP_TOKEN=replace-with-a-member-mcp-token
